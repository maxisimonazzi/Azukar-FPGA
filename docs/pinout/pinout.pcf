# ------------ Buttons (active low)
set_io -nowarn BTN0_ 118  # input
set_io -nowarn BTN1_ 117  # input
set_io -nowarn BTN2_ 116  # input
set_io -nowarn BTN3_ 115  # input
set_io -nowarn BTN4_ 114  # input
set_io -nowarn BTN5_ 113  # input
set_io -nowarn BTN6_ 112  # input
set_io -nowarn BTN7_ 110  # input

# ------------ User LEDs
set_io -nowarn LED0 37  #-- output
set_io -nowarn LED1 38  #-- output 
set_io -nowarn LED2 39  #-- output
set_io -nowarn LED3 41  #-- output 
set_io -nowarn LED4 42  #-- output 
set_io -nowarn LED5 43  #-- output
set_io -nowarn LED6 44  #-- output 
set_io -nowarn LED7 45  #-- output

# ------------ SYSTEM CLOCK
set_io -nowarn CLK12 49    # input
set_io -nowarn CLK100 129  # input

# ------------ FTDI (Virtual Serial port)
set_io -nowarn RX  64  # input
set_io -nowarn TX  63  # output
set_io -nowarn RTS 62  # input
set_io -nowarn CTS 61  # output
set_io -nowarn DTR 60  # input
set_io -nowarn DSR 56  # output
set_io -nowarn DCD 55  # output

# ------------ GPIO Bank 1
set_io -nowarn GPIO0 74  # input/output
set_io -nowarn GPIO1 76  # input/output
set_io -nowarn GPIO2 79  # input/output
set_io -nowarn GPIO3 81  # input/output
set_io -nowarn GPIO4 83  # input/output
